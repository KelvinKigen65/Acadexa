DJANGO_SECRET_KEY=change-me-before-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://acadexa:acadexa@db:5432/acadexa
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Development uses local_hash so the ingestion and retrieval path works without a provider.
# Set external values in production; the endpoint must implement the OpenAI-compatible
# /v1/embeddings response shape.
EMBEDDING_BACKEND=local_hash
EMBEDDING_DIMENSIONS=384
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=

# Optional OpenAI-compatible chat-completions endpoint. Empty means extractive-only
# answers: no ungrounded answer will be generated.
LLM_BACKEND=none
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
RAG_TOP_K=5
RAG_MIN_RELEVANCE=0.12
