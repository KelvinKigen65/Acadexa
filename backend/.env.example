DJANGO_SECRET_KEY=change-me-before-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgresql://acadexa:acadexa@db:5432/acadexa
CORS_ALLOWED_ORIGINS=http://localhost:5173

# OpenAI is the only hosted provider needed. Create a project API key in the
# OpenAI dashboard and place it here; never commit the real backend/.env file.
OPENAI_API_KEY=

# Use OpenAI for both document retrieval and answers. The defaults below are
# compatible with this project's fixed 384-dimensional pgvector column.
EMBEDDING_BACKEND=openai
EMBEDDING_DIMENSIONS=384
EMBEDDING_MODEL=text-embedding-3-small

# Acadexa uses the OpenAI Chat Completions endpoint for grounded answer writing.
LLM_BACKEND=openai
LLM_MODEL=gpt-4.1-mini
RAG_TOP_K=5
RAG_MIN_RELEVANCE=0.12
